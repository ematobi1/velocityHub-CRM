# VelocityHub CRM - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ======================
# DATABASE
# ======================
MONGODB_URI=mongodb://localhost:27017/velocityhub
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/velocityhub

# ======================
# SERVER
# ======================
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ======================
# JWT SECRET
# ======================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ======================
# AI/ML SERVICES (Optional - features work with mock data if not provided)
# ======================

# Multi-Provider AI Configuration
# The system intelligently routes requests to the best provider for each task

# OpenAI - For complex reasoning (Predictive Revenue, High-stakes proposals)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Claude - For conversations (Chatbot, Email writing, Proposals)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Groq - For fast real-time operations (Voice AI, Lead scoring, Sentiment)
# Get your FREE key from: https://console.groq.com/ (14,400 requests/day free)
GROQ_API_KEY=gsk_your_groq_api_key_here

# AI Provider Selection Strategy
# Options: 'auto' (intelligent routing), 'openai', 'claude', 'groq'
AI_PROVIDER_STRATEGY=auto

# AI Provider Priorities (comma-separated, for fallback)
AI_PROVIDER_PRIORITY=groq,claude,openai

# ======================
# SOCIAL MEDIA INTEGRATION (Optional)
# ======================

# LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5001/api/auth/linkedin/callback

# Twitter
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ======================
# LEAD ENRICHMENT SERVICES (Optional)
# ======================

# Clearbit - Contact & Company data enrichment
CLEARBIT_API_KEY=your_clearbit_api_key

# Hunter.io - Email finder and verification
HUNTER_API_KEY=your_hunter_api_key

# Apollo.io - B2B contact database
APOLLO_API_KEY=your_apollo_api_key

# ZoomInfo (Alternative to Apollo)
ZOOMINFO_API_KEY=your_zoominfo_api_key

# ======================
# COMMUNICATION SERVICES (Optional)
# ======================

# SendGrid for email
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourcompany.com

# Twilio for SMS/WhatsApp/Voice
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ======================
# PAYMENT PROCESSING (Optional)
# ======================

# Stripe for subscriptions
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ======================
# E-SIGNATURE (Optional)
# ======================

# DocuSign
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id

# ======================
# FILE STORAGE (Optional)
# ======================

# Cloudinary for image/file uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Or AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ======================
# REDIS (Optional - for caching and sessions)
# ======================

REDIS_URL=redis://localhost:6379
# Or Redis Cloud:
# REDIS_URL=redis://username:password@redis-host:port

# ======================
# NOTES
# ======================

# Priority setup (for basic functionality):
# 1. MONGODB_URI - Required
# 2. JWT_SECRET - Required
# 3. Everything else is optional and features will work with mock data

# To enable full functionality:
# 1. Get API keys from respective service websites
# 2. Replace placeholder values above
# 3. Restart the backend server

# Cost estimates (monthly):
# - OpenAI: $20-100 (pay per use)
# - LinkedIn/Twitter APIs: Free-$99
# - Clearbit: $99+
# - Hunter.io: $49+
# - Apollo.io: $99+
# - SendGrid: Free-$15
# - Twilio: $20-100 (pay per use)
# - Stripe: Free (2.9% per transaction)
# - DocuSign: $10-40
# - Cloudinary: Free-$89
# - MongoDB Atlas: Free-$57
# - Redis Cloud: Free-$10

# Total minimum: $0 (all features work with mock data for testing)
# Total for full production: $300-800/month
